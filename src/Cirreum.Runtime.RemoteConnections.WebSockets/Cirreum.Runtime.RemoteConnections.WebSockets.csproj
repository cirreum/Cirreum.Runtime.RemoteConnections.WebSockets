<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Cirreum.Runtime.RemoteConnections.WebSockets</AssemblyName>
		<RootNamespace>Cirreum.Runtime</RootNamespace>
		<Description>Runtime Extensions package for Cirreum raw WebSocket remote connections — app-facing AddRemoteConnection&lt;TConnection&gt;() and AddRemoteConnectionFactory&lt;TConnection&gt;() extensions that register a typed, lifecycle-managed WebSocket client connection from options.</Description>
		<PackageTags>cirreum;runtime;websockets;realtime;client;remoteconnections</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- Cirreum.Domain / Contracts / Kernel (incl. IDomainApplicationBuilder) flow in transitively. -->
		<PackageReference Include="Cirreum.RemoteConnections.WebSockets" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Cirreum.RemoteServices" />
		<Using Include="Cirreum.RemoteServices.Connections" />
	</ItemGroup>

	<!-- InternalsVisibleTo: Local Development Only -->
	<ItemGroup Label="InternalsVisibleTo" Condition="'$(IsLocalBuild)' == 'true'">
		<InternalsVisibleTo Include="Cirreum.Runtime.RemoteConnections.WebSockets.Tests" />
	</ItemGroup>

</Project>
